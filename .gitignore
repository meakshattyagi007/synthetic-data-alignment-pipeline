# ============================================================
# Automated Synthetic Data Generator & Model Alignment Pipeline
# Git Ignore Configuration
# ============================================================

# ── Credentials & Environment Secrets ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ── Python & Execution Caches ──
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual Environments ──
.venv/
venv/
ENV/
env/
dist/
build/
*.egg-info/

# ── Project Outputs (Serialized JSON Matrices) ──
# Prevents committing generated datasets and analytical trees.
output/

# ── Editor & IDE Settings ──
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ── OS & System Junk ──
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
