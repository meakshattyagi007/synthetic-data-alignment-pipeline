# ============================================================
# Automated Synthetic Data Generator & Model Alignment Pipeline
# Environment Variable Template
# ============================================================
# Copy this file to .env and fill in the values.
# The .env file MUST NOT be committed to version control.
# ============================================================

# [REQUIRED] Google Gemini API key — routes requests directly to Gemini 2.5 Flash / 1.5 Flash
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# [OPTIONAL] Output directory for all JSON result matrices.
# Relative paths are resolved from the project root.
# Default: output
OUTPUT_DIR=output
