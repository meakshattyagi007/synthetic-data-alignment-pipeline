# ============================================================
# Automated Synthetic Data Generator & Model Alignment Pipeline
# Environment Variable Template
# ============================================================
# Copy this file to .env and fill in the values.
# The .env file MUST NOT be committed to version control.
# ============================================================

# [REQUIRED] OpenRouter API key — routes requests to Gemini 2.5 Flash
# while bypassing strict Google direct Free Tier rate limits.
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# [OPTIONAL] Output directory for all JSON result matrices.
# Relative paths are resolved from the project root.
# Default: output
OUTPUT_DIR=output
